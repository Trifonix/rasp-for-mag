// Выполнил Дмитрий Трифонов, 12-25 РПм, 1 курс, Программная инженерия
// Практическая работа 5: Кибернетика: дискретный PID‑регулятор для первого порядка
// Вариант 12: a=0.85, b=0.7, r=1.0, u∈[−0.8,0.8]

clear; clc;

// ----------------------- ПАРАМЕТРЫ МОДЕЛИ ------------------------------
a = 0.85;         // коэффициент объекта
b = 0.7;          // коэффициент усиления объекта
r = 1.0;          // уставка
N = 200;          // время моделирования
x0 = 0;           // начальное состояние

// ----------------------- ОГРАНИЧЕНИЯ УПРАВЛЕНИЯ ------------------------
u_min = -0.8;
u_max = 0.8;

// ----------------------- КОЭФФИЦИЕНТЫ PID ------------------------------
// Подобранный устойчивый вариант
Kp = 1.2;
Ki = 0.15;
Kd = 0.05;

// ----------------------- ИНИЦИАЛИЗАЦИЯ МАССИВОВ ------------------------
x = zeros(1, N+1);
u = zeros(1, N);
e_prev = 0;        // e(k–1)
I = 0;             // интегральная сумма

x(1) = x0;

// ======================================================================
//                          ЦИКЛ МОДЕЛИРОВАНИЯ
// ======================================================================

for k = 1:N
    y = x(k);          // выход равен состоянию
    e = r - y;         // ошибка регулирования

    // Интегральная сумма
    I = I + e;

    // Дифференциальная часть
    D = e - e_prev;

    // PID-регулятор
    u(k) = Kp*e + Ki*I + Kd*D;

    // ---------------- САТУРАЦИЯ (ОГРАНИЧЕНИЕ) -------------------------

    if u(k) > u_max then
        u(k) = u_max;
    end

    if u(k) < u_min then
        u(k) = u_min;
    end

    // ---------------- МОДЕЛЬ ОБЪЕКТА -------------------------------
    x(k+1) = a*x(k) + b*u(k);

    // сохраняем e(k) для следующего шага
    e_prev = e;
end

// ======================================================================
//                         ГРАФИКИ РЕЗУЛЬТАТОВ
// ======================================================================

t = 0:N;
clf();

subplot(2,1,1);
plot(t, x);
xtitle("Выход y(k)", "k", "y");
xgrid();

subplot(2,1,2);
plot(0:N-1, u);
xtitle("Управление u(k)", "k", "u");
xgrid();

// ======================================================================
//                       МЕТРИКИ КАЧЕСТВА РЕГУЛИРОВАНИЯ
// ======================================================================

// Перерегулирование
ymax = max(x);
overshoot = (ymax - r) * 100;   // в %

disp("Перерегулирование (%):");
disp(overshoot);

// Статическая ошибка
steady_err = abs(x($) - r);

disp("Статическая ошибка:");
disp(steady_err);

// Время установления (±5%)
band = 0.05;                     // 5%
idx = find(abs(x - r) <= band);

if size(idx, "*") > 0 then
    t_s = idx(1);
else
    t_s = %nan;
end

disp("Время установления t_s:");
disp(t_s);

