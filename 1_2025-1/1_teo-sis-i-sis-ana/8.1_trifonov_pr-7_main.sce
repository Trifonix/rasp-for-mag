// Выполнил Дмитрий Трифонов, 12-25 РПм, 1 курс, Программная инженерия
// Практическая работа 7: Управляемость, наблюдаемость и стабилизация
// Вариант 12: A = [0 1; -2 0.1]

clear;
clc;

// ====== 1. Матрицы системы (вариант 12) ======
A = [0 1; -2 0.1];   // вариант 12 из ПЗ-6
B = [0; 1];
C = [1 0];
D = 0;

disp(A, "Матрица A:");
disp(B, "Матрица B:");
disp(C, "Матрица C:");

// ====== 2. Проверка управляемости ======
Co = [B A*B];
rank_Co = rank(Co);
disp(Co, "Матрица управляемости:");
disp(rank_Co, "Ранг матрицы управляемости:");

// ====== 3. Проверка наблюдаемости ======
Ob = [C; C*A];
rank_Ob = rank(Ob);
disp(Ob, "Матрица наблюдаемости:");
disp(rank_Ob, "Ранг матрицы наблюдаемости:");

// ====== 4. Исходная система (без управления) ======
x0 = [1; 0];              // начальное состояние
t = 0:0.01:20;

function xdot = f(t, x)
    xdot = A * x;
endfunction

x = ode(x0, 0, t, f);
y = C * x;

// ====== 5. Синтез управления ======
desired_poles = [-1, -2];   // желаемые корни
K = ppol(A, B, desired_poles);
disp(K, "Матрица обратной связи K:");

// Матрица замкнутой системы
Acl = A - B*K;
disp(spec(A), "Собственные значения A:");
disp(spec(Acl), "Собственные значения A_cl:");

// ====== 6. Замкнутая система ======
function xdot = f_cl(t, x)
    xdot = Acl * x;
endfunction

x_cl = ode(x0, 0, t, f_cl);
y_cl = C * x_cl;

// ====== 7. Графики ======
clf();

subplot(2,1,1);
plot(t, y);
xlabel("t, c");
ylabel("y(t)");
title("Исходная система (без управления)");
xgrid();

subplot(2,1,2);
plot(t, y_cl);
xlabel("t, c");
ylabel("y_cl(t)");
title("Замкнутая система (u = -Kx)");
xgrid();

// Выводы

// Для системы была составлена матрица управляемости Калмана: 𝐶 = [ 𝐵 𝐴 𝐵 ] C=[BAB] В результате вычислений получено: 𝑟 𝑎 𝑛 𝑘 ( 𝐶 ) = 2 rank(C)=2 Так как ранг матрицы управляемости равен размерности пространства состояний, система является полностью управляемой. Это означает, что с помощью управляющего воздействия возможно перевести систему из любого начального состояния в любое конечное за конечное время и выполнить стабилизацию.

// Проверка наблюдаемости Матрица наблюдаемости имеет вид: 𝑂 = [ 𝐶 𝐶 𝐴 ] O=[ C CA ​ ] В результате вычислений: 𝑟 𝑎 𝑛 𝑘 ( 𝑂 ) = 2 rank(O)=2 Следовательно, система является наблюдаемой, то есть по выходному сигналу возможно восстановить вектор состояния системы.

// Исходная динамика системы Анализ спектра матрицы A показывает, что система находится вблизи границы устойчивости. Переходный процесс без управления характеризуется медленным изменением выходной величины и отсутствием быстрого затухания, что свидетельствует о слабом демпфировании.

// Синтез управляющего воздействия Так как система управляемая, была введена линейная обратная связь по состоянию: 𝑢 ( 𝑡 ) = − 𝐾 𝑥 ( 𝑡 ) u(t)=−Kx(t) Собственные значения замкнутой системы были заданы равными: 𝜆 1 , 2 = − 1 , − 2 λ 1,2 ​ =−1,−2 С помощью метода размещения полюсов была получена матрица усилений K, обеспечивающая требуемую устойчивость замкнутой системы.

// Сравнение исходной и замкнутой систем После введения управления: собственные значения системы сместились в левую полуплоскость; переходный процесс стал устойчивым; существенно возросла скорость затухания; исчезли признаки слабой неустойчивости. Таким образом, управление позволило качественно улучшить динамические свойства системы.

// Итоговый вывод В ходе работы были исследованы структурные свойства линейной системы второго порядка. Установлено, что система варианта 12 является управляемой и наблюдаемой, что делает возможным синтез стабилизирующего управления. Метод размещения полюсов позволил целенаправленно изменить спектр системы и обеспечить асимптотическую устойчивость. Работа наглядно демонстрирует ключевую роль управляемости и наблюдаемости в задачах системного анализа и управления.
