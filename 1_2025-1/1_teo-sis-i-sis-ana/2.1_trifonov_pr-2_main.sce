// Выполнил Дмитрий Трифонов, 12-25 РПм, 1 курс, Программная инженерия
// Практическая работа 2: Открытая система (резервуар) — баланс потока и динамика уровня
// Вариант 12: S=1.0, c=0.15, dt=0.05, N=800, qin_base=0.2, pulse_amp=0.5, pulse [300,500]

clear; clc;

// ==================== Параметры системы ====================
S = 1.0;                  // Площадь сечения резервуара (м²)
c = 0.15;                 // Коэффициент оттока (1/с)
dt = 0.05;                // Шаг дискретизации (с)
N = 800;                  // Число дискретных шагов
h0 = 0.0;                 // Начальный уровень воды

qin_base = 0.2;           // Базовый приток (м³/с)
pulse_amp = 0.5;          // Амплитуда импульса (м³/с)
pulse_start = 300;        // Начало импульса (шаг)
pulse_end = 500;          // Конец импульса (шаг)

d = zeros(1,N);           // Дополнительное возмущение среды

// ==================== Формирование профиля притока ====================
qin = qin_base*ones(1,N);           // Инициализация притока постоянным значением
for k = pulse_start:pulse_end
    qin(k) = qin(k) + pulse_amp;    // Добавляем импульс
end

// ==================== Инициализация переменных ====================
h = zeros(1,N+1);                   // Уровень в резервуаре
h(1) = h0;

// ==================== Моделирование динамики уровня ====================
for k = 1:N
    qout = c*h(k);                                // Линейный отток
    h(k+1) = max(0, h(k) + dt*(qin(k) + d(k) - qout)/S); // Уровень с ограничением h>=0
end

// ==================== Расчет метрик ====================
h_eq = qin_base/c;                   // Равновесный уровень при постоянном притоке
h_max = max(h);                      // Максимальный уровень

// Функция вычисления времени возврата к зоне 5%
function t_ret = return_time(h, h_eq, eps)
    n = length(h)-1;
    tol = eps*abs(h_eq);
    t_ret = %nan;
    for k = 1:n+1
        if max(abs(h(k:$)-h_eq)) <= tol then
            t_ret = k-1;
            break;
        end
    end
endfunction

t_ret = return_time(h, h_eq, 0.05);  // Время возврата
drying = sum(h==0) > 0;              // Проверка пересушивания

// ==================== Построение графика ====================
t = (0:N)*dt;
clf();
plot(t,h,'-b','LineWidth',2);
xgrid();
xtitle("Динамика уровня h(t)","t, с","h, м");

// Горизонтальная линия h* (равновесный уровень)
plot([t(1), t($)], [h_eq, h_eq], 'r--');

// Вертикальная линия времени возврата t_ret
if ~isnan(t_ret) then
    plot([t_ret*dt, t_ret*dt], [0, max(h)], 'g--');
end

legend(['h(t)','h*','t_{ret}']);

// ==================== Вывод результатов ====================
mprintf("=== Результаты моделирования ===\n");
mprintf("Равновесный уровень h* = %g\n", h_eq);
mprintf("Максимальный уровень h_max = %g\n", h_max);
mprintf("Время возврата t_ret = %g с\n", t_ret*dt);
mprintf("Пересушивание h=0 на интервале: %s\n", string(drying));
