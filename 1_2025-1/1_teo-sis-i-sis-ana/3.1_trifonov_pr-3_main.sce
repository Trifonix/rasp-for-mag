// Выполнил Дмитрий Трифонов, 12-25 РПм, 1 курс, Программная инженерия
// Практическая работа 3: M/M/1 — Детерминированные и стохастические модели: очередь M/M/1
// Вариант 12: λ=0.75, μ=0.9, Tend=12000

clear; clc;

// ==================== Параметры модели ====================
lambda = 0.75;          // интенсивность входного потока (1/с)
mu = 0.9;               // интенсивность обслуживания (1/с)
Tend = 12000;           // горизонт моделирования (с)

rand("seed",123);       // для воспроизводимости

// ==================== Функция генерации экспоненциального интервала ====================
function e = exprnd(rate)
    e = -log(1 - rand()) / rate;
endfunction

// ==================== Функция вычисления перцентиля ====================
function p = percentile(x, perc)
    xs = gsort(x, "g", "i");          // сортируем по возрастанию
    n = length(xs);
    idx = max(1, round(perc/100*(n-1) + 1)); // индекс перцентиля
    p = xs(idx);
endfunction

// ==================== Инициализация переменных ====================
t = 0;                  // текущее время
busy = %f;              // сервер свободен
q = 0;                  // длина очереди
t_arr = exprnd(lambda); // время следующего прихода
t_dep = %inf;           // время следующего ухода
arr = [];               // массив времен прибытия
dep = [];               // массив времен ухода
Qlen = [];              // длина очереди во времени
busy_arr = [];          // статус сервера во времени
wait_times = [];        // времена ожидания заявок
response_times = [];    // времена отклика заявок

// ==================== Основной цикл дискретных событий ====================
while t < Tend
    if t_arr < t_dep then
        // событие: прибытие заявки
        t = t_arr;
        arr($+1) = t;

        if ~busy then
            // сервер свободен, сразу обслуживаем
            busy = %t;
            t_dep = t + exprnd(mu);
            wait_times($+1) = 0;                  // ожидание = 0
            response_times($+1) = t_dep - t;      // отклик = обслуживание
        else
            // сервер занят, добавляем в очередь
            q = q + 1;
        end
        // время следующего прихода
        t_arr = t + exprnd(lambda);
    else
        // событие: завершение обслуживания
        t = t_dep;
        dep($+1) = t;

        if q > 0 then
            // очередь не пуста, берем следующую заявку
            q = q - 1;
            t_dep = t + exprnd(mu);

            // рассчитываем время ожидания и отклика для первой заявки в очереди (FIFO)
            wait = t - arr(length(arr)-q);
            wait_times($+1) = wait;
            response_times($+1) = wait + (t_dep - t);
        else
            // очередь пуста, сервер свободен
            busy = %f;
            t_dep = %inf;
        end
    end
    // запись состояния очереди и сервера
    Qlen($+1) = q;
    busy_arr($+1) = busy;
end

// ==================== Расчет метрик ====================
rho = lambda/mu;                       // загрузка
E_W = mean(wait_times);                // среднее время ожидания
P90 = percentile(wait_times,90);       // 90-й перцентиль ожидания
P95 = percentile(wait_times,95);       // 95-й перцентиль ожидания
L_emp = mean(Qlen);                    // средняя длина очереди (эмпирика)
L_theory = lambda*E_W;                 // по Little

mprintf("=== Результаты моделирования ===\n");
mprintf("Загрузка rho = %.3f\n", rho);
mprintf("E[W] (эмпирика) = %.3f с\n", E_W);
mprintf("90-й перцентиль W = %.3f с\n", P90);
mprintf("95-й перцентиль W = %.3f с\n", P95);
mprintf("Средняя длина очереди L_emp = %.3f\n", L_emp);
mprintf("По Little L_theory = %.3f\n", L_theory);

// ==================== Построение графиков ====================
t_vec = linspace(0,Tend,length(Qlen));

clf();
subplot(2,1,1);
plot(t_vec,Qlen,'-b','LineWidth',2);
xtitle("Длина очереди q(t)","t, с","q");
xgrid();

subplot(2,1,2);
plot(1:length(wait_times),wait_times,'-r','LineWidth',2);
xtitle("Время ожидания заявок W","номер заявки","W, с");
xgrid();
