// Выполнил Дмитрий Трифонов, 12-25 РПм, 1 курс, Программная инженерия
// Практическая работа 6-1: Линейные динамические системы в пространстве состояний
// Вариант 12: A = [0 1; -2 0.1]

clear;
clc;

// ===== 1. Выбор варианта и задание матриц =====
variant = 1;

select variant
case 1
    A = [0 1; -2 -3];
case 2
    A = [0 1; -1 -1.2];
case 3
    A = [0 1; -4 -0.2];
case 4
    A = [0 1; -1 0];
case 5
    A = [0 1; -2 -0.5];
case 6
    A = [0 1; 0 0];
case 7
    A = [0 1; 1 0.2];
case 8
    A = [0 1; -3 -2];
case 9
    A = [0 1; -5 -1];
case 10
    A = [0 1; -0.5 -0.1];
case 11
    A = [0 1; -10 -3];
case 12
    A = [0 1; -2 0.1];
case 13
    A = [0 1; -3 -0.1];
case 14
    A = [0 1; 1 -1];
case 15
    A = [0 1; -6 -4];
else
    error("Недопустимый номер варианта");
end

// Общие матрицы
B = [0; 1];
C = [1 0];
D = 0;

// Вывод матриц
disp(A, "Матрица A:");
disp(B, "Матрица B:");
disp(C, "Матрица C:");
disp(D, "Матрица D:");

// ===== 2. Анализ устойчивости =====
lambda = spec(A);
disp(lambda, "Собственные значения матрицы A:");

// ===== 3. Описание динамики =====
function xdot = f(t, x)
    u = 1;          // ступенчатое воздействие
    xdot = A*x + B*u;
endfunction

// ===== 4. Моделирование переходного процесса =====
x0 = [0; 0];        // начальные условия
t = 0:0.01:20;      // время моделирования

x = ode(x0, 0, t, f);
y = C*x;

// ===== 5. Модификация матрицы A =====
A_new = A;
A_new(2,2) = A(2,2) + 1;   // ослабление демпфирования

lambda_new = spec(A_new);
disp(lambda_new, "Собственные значения матрицы A_new:");

// Новая динамика
function xdot_new = f_new(t, x)
    u = 1;
    xdot_new = A_new*x + B*u;
endfunction

x_new = ode(x0, 0, t, f_new);
y_new = C*x_new;

// ===== 6. Графики =====
clf();

subplot(2,1,1);
plot(t, y);
xlabel("t, c");
ylabel("y(t)");
title("Переходной процесс (исходная матрица A)");
xgrid();

subplot(2,1,2);
plot(t, y_new);
xlabel("t, c");
ylabel("y_{new}(t)");
title("Переходной процесс (модифицированная матрица A_new)");
xgrid();

// Выводы

// Целью практической работы является изучение линейной динамической системы второго порядка в форме пространства состояний, анализ её устойчивости по спектру матрицы A, а также исследование переходных процессов при ступенчатом входном воздействии с использованием среды SciLab.

// Анализ устойчивости По результатам вычисления собственных значений матрицы A установлено, что: действительные части всех собственных значений (отрицательные / положительные / равны нулю), что позволяет сделать вывод о (асимптотической устойчивости / неустойчивости / нахождении на границе устойчивости) системы.

// Переходный процесс Анализ графика переходного процесса показал, что: выходная величина (монотонно / колебательно) стремится к установившемуся значению; (наблюдается / не наблюдается) перерегулирование; характер процесса соответствует спектру матрицы A.

// Модификация системы После изменения элемента матрицы A спектр системы изменился, что привело к: изменению устойчивости / появлению колебаний / изменению скорости затухания; переходный процесс стал более медленным / колебательным / менее демпфированным.

// В ходе работы было показано, что параметры матрицы A оказывают решающее влияние на устойчивость и динамические свойства системы. Даже незначительное изменение коэффициентов может привести к качественному изменению характера переходного процесса, что подтверждает важность спектрального анализа при исследовании линейных систем.

