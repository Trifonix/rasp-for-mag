// Выполнил Дмитрий Трифонов, 12-25 РПм, 1 курс, Программная инженерия
// Практическая работа 1: Дискретная линейная система первого порядка
// Вариант 12: a=-0.9, b=1.0, u0=1, N=150, eps=0.02

clear; clc;

// ==================== Параметры системы ====================
a  = -0.9;       // Полюс системы (коэффициент обратной связи)
b  = 1.0;        // Коэффициент усиления канала управления
u0 = 1.0;        // Амплитуда ступенчатого воздействия
N  = 150;        // Количество дискретных шагов моделирования
x0 = 0.0;        // Начальное состояние системы
eps = 0.02;      // Допуск для времени установления

// ==================== Создание сигналов ====================
u = u0*ones(1,N);          // Вход: ступень
x = zeros(1,N+1);          // Выход: инициируем нулями
x(1) = x0;                 // Задаем начальное значение

// ==================== Моделирование системы ====================
for k=1:N
    x(k+1) = a*x(k) + b*u(k);
end

// ==================== Аналитическое установившееся значение ====================
if abs(a) < 1 then
    x_ss = b*u0/(1-a);    // Стационарное значение для устойчивой системы
else
    x_ss = %nan;          // Неустойчивая система — стационарного значения нет
end

// ==================== Функция вычисления времени установления ====================
function ts = settling_time(x, x_ss, eps)
    // x     : сигнал выхода
    // x_ss  : установившееся значение
    // eps   : относительный допуск
    n = length(x)-1;
    ts = %nan;               // по умолчанию, если не найдено
    tol = eps*abs(x_ss);     // абсолютный допуск
    for k=1:n+1
        if max(abs(x(k:$)-x_ss)) <= tol then
            ts = k-1;        // шаг времени установления
            break;
        end
    end
endfunction

ts = settling_time(x, x_ss, eps);   // Вычисляем время установления

// ==================== Вычисление перерегулирования ====================
if ~isnan(x_ss) then
    overshoot = max(0, (max(x)-x_ss)/abs(x_ss));  // Перерегулирование
else
    overshoot = %nan;
end

// ==================== Построение графика ====================
t = 0:N;
clf();
plot(t, x, '-o', 'LineWidth', 2);
xtitle('Переходный процесс x(k)', 'k', 'x');
xgrid();
if ~isnan(x_ss) then
    // Отмечаем установившееся значение
    xline(x_ss, 'r--');  
end
if ~isnan(ts) then
    // Отмечаем время установления
    xline(x(ts+1), 'g--');  
end
legend(['x(k)'; 'x*'; 't_s']);

// ==================== Вывод результатов в консоль ====================
mprintf("Устойчивость системы: %s\n", string(abs(a)<1));
mprintf("Стационарное значение x* = %g\n", x_ss);
mprintf("Время установления t_s = %g шагов\n", ts);
mprintf("Перерегулирование = %g\n", overshoot);

// ==================== Выводы ====================
// - Система устойчива, если |a|<1
// - Время установления увеличивается при a → 1-
// - При a<0 переход может быть колебательным
// - Стационарное значение зависит от b и u0: x* = b*u0/(1-a)
